        }
    };
    
    //declval
    template<typename T>
    T&& declval();
    
    // is_conv
    template<typename U>
    void conv_sink(U);
    template<typename T,typename U>
    auto conv_test(int) -> decltype(
        conv_sink<U>(declval<T>()),
        char{}
    );
    template<typename,typename>
    auto conv_test(...) -> long;
    template<typename T,typename U>
    struct is_conv{
        constexpr operator bool(){
            return sizeof(conv_test<T,U>(0))==sizeof(char);
        }
    };
    
    // remove_reference
    template<typename T>
    struct rm_ref{
        using type=T;
    };

    template<typename T>
    struct rm_ref<T&>{
        using type=T;
    };

    template<typename T>
    struct rm_ref<T&&>{
        using type=T;
    };
    template<typename T>
    using rm_ref_t=typename rm_ref<T>::type;
    
    //remove_constant
    template<typename T>
    struct rm_volatile{
        using type=T;
    };

    template<typename T>
    struct rm_volatile<volatile T>{
        using type=T;
    };
    template<typename T>
    using rm_volatile_t=typename rm_volatile<T>::type;

    //remove_volatile
    template<typename T>
    struct rm_const{
        using type=T;
    };

    template<typename T>
    struct rm_const<const T>{
        using type=T;
    };
    template<typename T>
    using rm_const_t=typename rm_const<T>::type;
    
    // decay_impl
    template<typename T>
    struct decay_impl{
        using type=rm_const_t<rm_volatile_t<T>>;
    };
    template<typename T,unsigned long N>
    struct decay_impl<T[N]>{
        using type=T*;
    };
    template<typename T>
    struct decay_impl<T[]>{
        using type=T*;
    };
    template<typename R,typename... Args>
    struct decay_impl<R(Args...)>{
        using type=R(*)(Args...);
    };
    // decay
    template<typename T>
    struct decay{
    private:
        using U=rm_ref_t<T>;

    public:
        using type=typename decay_impl<U>::type;
    };
    template<typename T>
    using decay_t=typename decay<T>::type;
}
#endif