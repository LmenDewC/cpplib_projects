    };
    
    //is_integral
    template<typename T>
    struct is_integral{
        constexpr operator bool(){
            if constexpr(
            ts::is_same<T,char>{}||
            ts::is_same<T,short>{}||
            ts::is_same<T,int>{}||
            ts::is_same<T,long>{}||
            ts::is_same<T,long long>{}||
            ts::is_same<T,unsigned int>{}||
            ts::is_same<T,bool>{})return true;
            return false;
        }
    };
    
    //is_floating_pnt
    template<typename T>
    struct is_floating_pnt{
        constexpr operator bool(){
            if constexpr(
            ts::is_same<T,float>{}||
            ts::is_same<T,double>{}||
            ts::is_same<T,long double>{})return true;
            return false;
        }
    };
    
    //is_arithmetic
    template<typename T>
    struct is_arithmetic{
        constexpr operator bool(){
            if constexpr(ts::is_integral<T>{}||ts::is_floating_pnt<T>{})return true;
            return false;
        }
    };
    
